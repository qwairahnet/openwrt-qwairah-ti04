#!/bin/sh
# الهوية واسم الموديل والتوقيت (عدن - اليمن)
uci set system.@system[0].hostname='QWAIRAH'
uci set system.@system[0].zonename='Asia/Aden'
uci set system.@system[0].timezone='<+03>-3'
[ ! -f /tmp/sysinfo/model ] && mkdir -p /tmp/sysinfo && echo "TI08-708H / KT-9200" > /tmp/sysinfo/model
uci commit system

# الآيبي الثابت 192.168.1.1 + DNS 1.1.1.3 / 1.0.0.3 + دمج LAN و WAN في br-lan + إيقاف IPv6
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci delete network.lan.ip6assign 2>/dev/null || true
uci set network.lan.dns='1.1.1.3 1.0.0.3'
uci set network.wan.proto='none' 2>/dev/null || true
for dev in $(uci show network | grep "name='br-lan'" | cut -d. -f1-2); do
  uci add_list ${dev}.ports='wan' 2>/dev/null || true
done
uci commit network

# إيقاف DHCP و IPv6
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci commit dhcp

# إغلاق الجدار الناري Firewall
uci set firewall.@defaults[0].input='ACCEPT'
uci set firewall.@defaults[0].output='ACCEPT'
uci set firewall.@defaults[0].forward='ACCEPT'
for z in 0 1; do
  uci set firewall.@zone[$z].input='ACCEPT' 2>/dev/null || true
  uci set firewall.@zone[$z].output='ACCEPT' 2>/dev/null || true
  uci set firewall.@zone[$z].forward='ACCEPT' 2>/dev/null || true
done
/etc/init.d/firewall stop 2>/dev/null || true
/etc/init.d/firewall disable 2>/dev/null || true
uci commit firewall

# إعداد كروت الواي فاي: بنما (PA)، WDS، ماكات عشوائية مستقلة لكل كرت، بدون كلمة سر
RAND_MAC1=$(printf '02:%02x:%02x:%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
RAND_MAC2=$(printf '06:%02x:%02x:%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))

if [ "2g_first" = "5g_only" ]; then
  uci set wireless.radio0.disabled='0'
  uci set wireless.radio0.country='PA'
  uci set wireless.radio0.channel='104'
  uci set wireless.radio0.htmode='VHT80'
  uci set wireless.radio0.txpower='20'
  uci set wireless.default_radio0.ssid='QWAIRAH 5G'
  uci set wireless.default_radio0.encryption='none'
  uci set wireless.default_radio0.wds='1'
  uci set wireless.default_radio0.macaddr="$RAND_MAC1"
elif [ "2g_first" = "5g_first" ]; then
  uci set wireless.radio0.disabled='0'
  uci set wireless.radio0.country='PA'
  uci set wireless.radio0.channel='104'
  uci set wireless.radio0.htmode='VHT80'
  uci set wireless.radio0.txpower='20'
  uci set wireless.default_radio0.ssid='QWAIRAH 5G'
  uci set wireless.default_radio0.encryption='none'
  uci set wireless.default_radio0.wds='1'
  uci set wireless.default_radio0.macaddr="$RAND_MAC1"

  uci set wireless.radio1.disabled='0'
  uci set wireless.radio1.country='PA'
  uci set wireless.radio1.channel='6'
  uci set wireless.radio1.htmode='HT20'
  uci set wireless.radio1.txpower='20'
  uci set wireless.default_radio1.ssid='QWAIRAH 2G'
  uci set wireless.default_radio1.encryption='none'
  uci set wireless.default_radio1.wds='1'
  uci set wireless.default_radio1.macaddr="$RAND_MAC2"
else
  uci set wireless.radio0.disabled='0'
  uci set wireless.radio0.country='PA'
  uci set wireless.radio0.channel='6'
  uci set wireless.radio0.htmode='HT20'
  uci set wireless.radio0.txpower='20'
  uci set wireless.default_radio0.ssid='QWAIRAH 2G'
  uci set wireless.default_radio0.encryption='none'
  uci set wireless.default_radio0.wds='1'
  uci set wireless.default_radio0.macaddr="$RAND_MAC1"

  uci set wireless.radio1.disabled='0'
  uci set wireless.radio1.country='PA'
  uci set wireless.radio1.channel='104'
  uci set wireless.radio1.htmode='VHT80'
  uci set wireless.radio1.txpower='20'
  uci set wireless.default_radio1.ssid='QWAIRAH 5G'
  uci set wireless.default_radio1.encryption='none'
  uci set wireless.default_radio1.wds='1'
  uci set wireless.default_radio1.macaddr="$RAND_MAC2"
fi
uci commit wireless

# حقن السكربت البصري في قوالب LuCI
for tpl in /usr/lib/lua/luci/view/themes/*/header.htm; do
  [ -f "$tpl" ] && sed -i 's|</head>|<script src="/luci-static/resources/qwairah_inject.js"></script></head>|g' "$tpl"
done

# تفعيل خدمة إشعارات تيليجرام وإعادة التشغيل المجدول و SSH
/etc/init.d/qwairah-notify enable
/etc/init.d/cron enable
passwd -d root
exit 0
